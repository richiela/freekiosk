<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.laiholdings.kioskadbkeeper">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- localhost sockets to identify adbd (AdbPort) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- debuggable: only so `adb shell run-as` can read the log file (Log2) -->
    <application android:name=".KeeperApp" android:label="Kiosk ADB Keeper" android:allowBackup="false"
        android:debuggable="true">
        <activity android:name=".StartActivity" android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".BootReceiver" android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".SetupReceiver" android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver android:name=".NetReceiver" android:exported="false"
            android:directBootAware="true" />
        <service android:name=".PromptService" android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/prompt_service" />
        </service>
        <service android:name=".KeepJob" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
